# =================================================================
# Adera Foundation Platform - Production Environment Configuration
# =================================================================

# Database Credentials
DB_NAME=adera_prod
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here
DB_PORT=6432

# Authentication
JWT_SECRET=generate_a_long_random_jwt_secret_key_here_32_chars
JWT_EXPIRATION=7d

# Domain & Platform URLs
APP_URL=https://aderafoundation.com
API_URL=https://api.aderafoundation.com/api
ADMIN_URL=https://admin.aderafoundation.com
STORE_URL=https://shop.aderafoundation.com

# Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=https://api.aderafoundation.com/api
NEXT_PUBLIC_APP_URL=https://aderafoundation.com
NEXT_PUBLIC_STORE_URL=https://shop.aderafoundation.com
NEXT_PUBLIC_ADMIN_URL=https://admin.aderafoundation.com

# SMTP Email Configuration (Hostinger / Custom Mail Server)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Info@aderafoundation.com
SMTP_PASS=your_email_password_here
FROM_EMAIL="Adera Foundation <Info@aderafoundation.com>"
STORE_FROM_EMAIL="Adera Store <Info@aderafoundation.com>"
ADMIN_NOTIFICATION_EMAIL=Info@aderafoundation.com

# Optional AI Features (Admin Story Auto-Drafting)
DEEPSEEK_API_KEY=your_deepseek_api_key_optional
